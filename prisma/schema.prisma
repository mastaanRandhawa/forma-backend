// Forma — AI Personal Trainer · backend data model
// Mirrors §21 of forma-product-design-spec.md, plus the web companion's
// goals / wallet / store / achievements surfaces (frontend/src/lib/data.ts).
//
// Notes:
//  - The mobile client is local-first (SQLite on device). This schema is the
//    cloud sync store + system of record for cross-device data and the AI layer.
//  - Raw camera frames / raw per-frame pose data are NEVER stored here. Only
//    categorical form scores + fault labels + key joint-angle snapshots.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum AuthProvider {
  email
  apple
  google
}

enum Role {
  user
  admin
}

/// Purpose discriminator for one-time email tokens (verify / change-email).
enum VerificationPurpose {
  email_verify
  email_change
}

enum UnitPreference {
  metric
  imperial
}

enum FitnessGoal {
  build_muscle
  lose_fat
  get_stronger
  general_fitness
  athletic_performance
  maintain
}

enum ExperienceLevel {
  beginner
  intermediate
  advanced
}

enum TrainingLocation {
  gym
  home
  both
}

enum MuscleRegion {
  upper
  lower
  core
}

enum MuscleRole {
  primary
  secondary
  stabilizer
}

enum WorkoutSource {
  ai_generated
  manual
  template
  program
}

enum ProgramStructure {
  linear
  undulating
  split_defined
}

enum SessionStatus {
  in_progress
  completed
  abandoned
}

enum TrackingMode {
  camera
  manual
}

enum PersonalRecordType {
  max_weight
  max_1rm_estimate
  max_reps
  max_volume
}

enum ProgressMetricType {
  bodyweight
  measurement
  form_score_aggregate
  volume_aggregate
  readiness
  sleep
  hrv
  resting_hr
  steps
  protein
  calories
}

enum ProgressMetricSource {
  manual_entry
  health_sync
  computed
}

enum PhotoPose {
  front
  side
  back
}

enum ChatRole {
  user
  trainer
}

enum GoalCadence {
  daily
  weekly
}

enum StoreCategory {
  voice
  personality
  look
  theme
}

enum WalletTxnType {
  earn
  spend
}

enum FormDataVerbosity {
  minimal // only aggregate form score
  categorical // + fault type labels (default, per §22.4)
  detailed // + key joint-angle snapshots
}

enum InsightCategory {
  recovery
  volume
  form
  consistency
  nutrition
  strength
}

enum SupersetType {
  straight
  superset
  circuit
}

enum ProgramDayStatus {
  scheduled
  completed
  missed
  rescheduled
}

/// How a deterministic recommendation was reached (§L / audit metadata).
enum RecommendationKind {
  prescription
  deload
  readiness_adjustment
  swap
}

// ─────────────────────────────────────────────────────────────────────────────
// Account / identity
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id    String @id @default(cuid())
  email String @unique
  name  String

  authProvider AuthProvider @default(email)
  passwordHash String? // null for social-only accounts
  appleSub     String?      @unique
  googleSub    String?      @unique

  // ── auth security (see modules/auth.ts, middleware/auth.ts) ──
  role              Role      @default(user)
  emailVerifiedAt   DateTime? // null ⇒ email/password account still unverified
  passwordChangedAt DateTime?
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime? // brute-force lockout window

  dateOfBirth      DateTime?
  biologicalSex    String? // "male" | "female" | "other" | "prefer_not_to_say"
  heightCm         Float?
  weightKg         Float? // denormalized from latest BodyMeasurement
  unitPreference   UnitPreference @default(metric)
  weekStartsMonday Boolean        @default(true)

  fitnessGoal             FitnessGoal?
  experienceLevel         ExperienceLevel?
  trainingLocation        TrainingLocation?
  trainingFrequencyTarget Int? // days per week
  sessionLengthTargetMin  Int?

  onboardingCompletedAt DateTime?

  // Camera & privacy settings (S8) — §22.4 configurable verbosity
  formDataVerbosity  FormDataVerbosity @default(categorical)
  saveHighlightClips Boolean           @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft-delete for account removal

  trainer              Trainer?
  authSessions         Session[]
  refreshTokens        RefreshToken[]
  passwordResets       PasswordReset[]
  verificationTokens   VerificationToken[]
  authEvents           AuthEvent[]
  injuries             InjuryNote[]
  equipment            UserEquipment[]
  workouts             Workout[]
  programs             TrainingProgram[]
  sessions             WorkoutSession[]
  personalRecords      PersonalRecord[]
  progressMetrics      ProgressMetric[]
  progressPhotos       ProgressPhoto[]
  bodyMeasurements     BodyMeasurement[]
  chatMessages         ChatMessage[]
  coachingInsights     CoachingInsight[]
  goals                Goal[]
  achievements         UserAchievement[]
  wallet               Wallet?
  ownedStoreItems      UserStoreItem[]
  customization        UserCustomization?
  notifications        Notification[]
  notificationPrefs    NotificationPreference?
  subscription         Subscription?
  deviceConnections    DeviceConnection[]
  appearance           UserAppearance?
  disclosure           UserDisclosure?
  progression          UserProgression?
  recommendationAudits RecommendationAudit[]
  recoveryCheckins     RecoveryCheckin[]
  nutritionEntries     NutritionEntry[]
  customFoods          Food[]                @relation("CustomFoods")
  foodLogs             FoodLog[]
  favoriteFoods        FavoriteFood[]
  nutritionGoal        NutritionGoal?

  @@index([createdAt])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// A durable login session ("device"). Survives refresh-token rotation; carries
/// the revocation flag the access-token check enforces on every request.
model Session {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?
  ip         String?

  refreshTokens RefreshToken[]

  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?
  session   Session?  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?
  ip        String?

  @@index([userId])
  @@index([sessionId])
}

/// One-time email token for address verification and email-change confirmation.
model VerificationToken {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   VerificationPurpose
  tokenHash String              @unique
  newEmail  String? // set only for purpose = email_change
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId, purpose])
}

/// Append-only audit trail for security-relevant auth events. Never stores raw
/// tokens, passwords, or MFA secrets.
model AuthEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String? // captured for events with no resolvable user (failed login)
  event     String // "login_success" | "login_failed" | "mfa_enabled" | ...
  ip        String?
  userAgent String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([event, createdAt])
}

model InjuryNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag       String // e.g. "left shoulder", "lower back"
  note      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([userId])
}

model UserEquipment {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id])

  @@unique([userId, equipmentId])
}

model Equipment {
  id   String  @id @default(cuid())
  key  String  @unique // "barbell", "dumbbell", "cable", "bodyweight", ...
  name String
  icon String?

  users UserEquipment[]
}

// ─────────────────────────────────────────────────────────────────────────────
// AI Trainer configuration
// ─────────────────────────────────────────────────────────────────────────────

model Trainer {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name     String @default("Kai")
  avatarId String @default("l-signature")
  voiceId  String @default("v-marcus")

  // §10.3 personality dimensions (0..1)
  motivationLevel    Float @default(0.6)
  coachingDirectness Float @default(0.6)
  formStrictness     Float @default(0.7)
  speakingFrequency  Float @default(0.5)
  coachingDetail     Float @default(0.6)
  humor              Float @default(0.3)

  equippedThemeId String @default("t-default")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Reference data — exercise library & muscle groups (shared, not per-user)
// ─────────────────────────────────────────────────────────────────────────────

model MuscleGroup {
  id            String        @id @default(cuid())
  key           String        @unique // "chest", "quads", "lats", ...
  name          String // anatomical
  plainName     String // plain-language
  region        MuscleRegion
  meshRegionId  String? // maps to the 3D model's segmented mesh region
  parentGroupId String?
  parentGroup   MuscleGroup?  @relation("MuscleHierarchy", fields: [parentGroupId], references: [id])
  children      MuscleGroup[] @relation("MuscleHierarchy")

  exerciseLinks     ExerciseMuscle[]
  muscleActivations MuscleActivation[]
}

model Exercise {
  id                     String          @id @default(cuid())
  slug                   String          @unique
  name                   String
  aliases                String[]        @default([])
  category               String // "push", "pull", "legs", "core", "olympic", ...
  movementPattern        String? // "horizontal_press", "squat", "hinge", ...
  equipment              String[]        @default([])
  difficulty             ExperienceLevel @default(intermediate)
  instructions           String[]        @default([])
  commonMistakes         String[]        @default([])
  aiFormTips             String[]        @default([])
  videoAssetRef          String?
  supportsCameraTracking Boolean         @default(false)
  alternativeSlugs       String[]        @default([])

  // ── Enrichment layer — provenance + RepDB (repdb.co) free-tier fields ──────
  // `source` = "native" (hand-curated seed) | "repdb" (imported). `externalId`
  // is the RepDB slug; native rows may also carry it once matched/enriched.
  // These fields never feed the adaptation engine — they are display metadata.
  source        String   @default("native")
  externalId    String?  @unique
  description   String?
  formTips      String[] @default([]) // RepDB `tips_en` (distinct from AI-generated aiFormTips)
  bodyPart      String? // "chest" | "back" | "upper_legs" | ...
  forceType     String? // "push" | "pull" | "static" | "dynamic"
  mechanic      String? // "compound" | "isolation"
  discipline    String? // RepDB `category`: "strength" | "stretching" | "cardio" | "olympic" | "plyometrics"
  isUnilateral  Boolean?
  isBodyweight  Boolean?
  metValue      Float? // metabolic equivalent — calorie estimation only
  trainingGoals String[] @default([]) // "hypertrophy" | "strength" | "endurance" | "mobility" | "power" | ...
  imageStartUrl String? // start-position illustration (RepDB flat 512px WebP)
  imageEndUrl   String? // peak / end-position illustration (single-pose moves reuse imageStartUrl)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  muscles          ExerciseMuscle[]
  workoutExercises WorkoutExercise[]
  performances     ExercisePerformance[]
  personalRecords  PersonalRecord[]

  @@index([category])
  @@index([source])
}

model ExerciseMuscle {
  id            String      @id @default(cuid())
  exerciseId    String
  exercise      Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  muscleGroupId String
  muscleGroup   MuscleGroup @relation(fields: [muscleGroupId], references: [id], onDelete: Cascade)
  role          MuscleRole
  weight        Float       @default(1.0) // contribution weight for activation math

  @@unique([exerciseId, muscleGroupId, role])
}

// ─────────────────────────────────────────────────────────────────────────────
// Planning — what was planned
// ─────────────────────────────────────────────────────────────────────────────

model TrainingProgram {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  structureType ProgramStructure @default(split_defined)
  durationWeeks Int
  generatedBy   WorkoutSource    @default(ai_generated)
  active        Boolean          @default(true)
  createdAt     DateTime         @default(now())

  // Schedule (§2.4) — preferred training weekdays (0=Sun..6=Sat) + anchor date.
  preferredWeekdays Int[]     @default([])
  startDate         DateTime?

  days ProgramDay[]

  @@index([userId])
}

model ProgramDay {
  id        String          @id @default(cuid())
  programId String
  program   TrainingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  weekIndex Int
  dayIndex  Int
  label     String? // "Push A", "Rest", ...
  workoutId String?
  workout   Workout?        @relation(fields: [workoutId], references: [id])

  // Resolved-schedule tracking (§2.4). `scheduledDate` is set when the program
  // week is anchored to the calendar; `status` advances as sessions land / lapse.
  scheduledDate DateTime?
  status        ProgramDayStatus @default(scheduled)
  sessionId     String?

  @@unique([programId, weekIndex, dayIndex])
}

model Workout {
  id                   String        @id @default(cuid())
  userId               String
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                 String
  source               WorkoutSource @default(manual)
  isTemplate           Boolean       @default(false)
  scheduledDate        DateTime?
  estimatedDurationMin Int?
  targetMuscleKeys     String[]      @default([])
  notes                String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exercises   WorkoutExercise[]
  sessions    WorkoutSession[]
  programDays ProgramDay[]

  @@index([userId, scheduledDate])
}

model WorkoutExercise {
  id             String       @id @default(cuid())
  workoutId      String
  workout        Workout      @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId     String
  exercise       Exercise     @relation(fields: [exerciseId], references: [id])
  order          Int
  targetSets     Int
  targetRepsMin  Int?
  targetRepsMax  Int?
  targetWeightKg Float?
  targetRestSec  Int?
  notes          String?
  supersetGroup  Int? // exercises sharing a value are grouped (W16)
  supersetType   SupersetType @default(straight)

  @@unique([workoutId, order])
}

// ─────────────────────────────────────────────────────────────────────────────
// Execution — what actually happened
// ─────────────────────────────────────────────────────────────────────────────

model WorkoutSession {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutId        String?
  workout          Workout?      @relation(fields: [workoutId], references: [id])
  name             String
  startedAt        DateTime      @default(now())
  endedAt          DateTime?
  status           SessionStatus @default(in_progress)
  trackingMode     TrackingMode  @default(manual)
  totalVolumeKg    Float         @default(0)
  durationSeconds  Int           @default(0)
  caloriesEstimate Int?
  healthWorkoutRef String?
  trainerComment   String?

  createdAt DateTime @default(now())

  performances      ExercisePerformance[]
  muscleActivations MuscleActivation[]
  personalRecords   PersonalRecord[]

  @@index([userId, startedAt])
}

model ExercisePerformance {
  id            String         @id @default(cuid())
  sessionId     String
  session       WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId    String
  exercise      Exercise       @relation(fields: [exerciseId], references: [id])
  order         Int
  formScoreAvg  Float?
  romAvg        Float?
  supersetGroup Int?

  // Prescribed targets for this session (§2.1) — derived from history by
  // services/prescription.ts, not copied blindly from the template.
  prescribedWeightKg  Float?
  prescribedReps      Int?
  prescribedRpe       Float?
  prescriptionAuditId String?              @unique
  prescriptionAudit   RecommendationAudit? @relation(fields: [prescriptionAuditId], references: [id])

  sets ExerciseSet[]

  @@unique([sessionId, order])
}

model ExerciseSet {
  id               String              @id @default(cuid())
  performanceId    String
  performance      ExercisePerformance @relation(fields: [performanceId], references: [id], onDelete: Cascade)
  setNumber        Int
  weightKg         Float?
  reps             Int?
  rpe              Float?
  restSecondsTaken Int?
  isWarmup         Boolean             @default(false)
  completedAt      DateTime?
  formScore        Float? // camera-tracked only
  romValue         Float?
  isPersonalRecord Boolean             @default(false)

  formAnalyses   FormAnalysis[]
  personalRecord PersonalRecord?

  @@unique([performanceId, setNumber])
}

model FormAnalysis {
  id                 String      @id @default(cuid())
  setId              String
  set                ExerciseSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  repIndex           Int
  jointAngleSnapshot Json // key angles only — NOT raw pose frames
  romValue           Float?
  tempoSeconds       Float?
  detectedFaults     Json // [{ type, severity }]
  overallRepScore    Float?

  @@unique([setId, repIndex])
}

model PersonalRecord {
  id            String             @id @default(cuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId    String
  exercise      Exercise           @relation(fields: [exerciseId], references: [id])
  recordType    PersonalRecordType
  value         Float
  previousValue Float?
  achievedAt    DateTime           @default(now())
  setId         String?            @unique
  set           ExerciseSet?       @relation(fields: [setId], references: [id])
  sessionId     String?
  session       WorkoutSession?    @relation(fields: [sessionId], references: [id])

  @@index([userId, exerciseId, recordType])
}

// ─────────────────────────────────────────────────────────────────────────────
// Derived / computed layer
// ─────────────────────────────────────────────────────────────────────────────

model MuscleActivation {
  id              String         @id @default(cuid())
  sessionId       String
  session         WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  muscleGroupId   String
  muscleGroup     MuscleGroup    @relation(fields: [muscleGroupId], references: [id])
  role            MuscleRole
  activationScore Float // 0..1 intensity feeding the 3D render

  @@unique([sessionId, muscleGroupId, role])
}

model ProgressMetric {
  id         String               @id @default(cuid())
  userId     String
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  metricType ProgressMetricType
  key        String? // for measurement subtype e.g. "waist", "arm_left"
  value      Float
  unit       String
  recordedAt DateTime             @default(now())
  source     ProgressMetricSource @default(manual_entry)

  @@index([userId, metricType, recordedAt])
}

model BodyMeasurement {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weightKg   Float?
  bodyFatPct Float?
  chestCm    Float?
  waistCm    Float?
  hipsCm     Float?
  thighCm    Float?
  armCm      Float?
  recordedAt DateTime @default(now())

  @@index([userId, recordedAt])
}

model ProgressPhoto {
  id       String    @id @default(cuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetRef String // storage key of the encrypted object
  poseTag  PhotoPose @default(front)
  takenAt  DateTime  @default(now())

  @@index([userId, takenAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Trainer chat
// ─────────────────────────────────────────────────────────────────────────────

model ChatMessage {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            ChatRole
  content         String
  richContent     Json? // inline cards: exercise / chart / applyAction
  viaVoice        Boolean   @default(false)
  trainerSnapshot Json? // §21: the Trainer config that produced this message (QA traceability)
  appliedAt       DateTime? // set when an ApplyAction card in this message was applied
  createdAt       DateTime  @default(now())

  @@index([userId, createdAt])
}

/// Coaching Insights Log (T4) — trainer observations, distinct from chat turns.
model CoachingInsight {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    InsightCategory
  title       String
  body        String
  dataRefs    Json? // links to the metrics/sessions that triggered it
  sparkline   Json? // optional inline trend series
  actions     String[]        @default([])
  proactive   Boolean         @default(true) // true = surfaced by the engine, not asked for
  dismissedAt DateTime?
  createdAt   DateTime        @default(now())

  @@index([userId, createdAt])
}

/// Notification Preferences (S6)
model NotificationPreference {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutReminders Boolean  @default(true)
  restTimerAlerts  Boolean  @default(true)
  trainerMessages  Boolean  @default(true)
  milestones       Boolean  @default(true)
  weeklySummary    Boolean  @default(true)
  checkIns         Boolean  @default(true)
  reminderTime     String   @default("18:00") // local HH:mm for the daily nudge
  quietHoursStart  String? // HH:mm
  quietHoursEnd    String?
  updatedAt        DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Goals · achievements · streaks (web companion)
// ─────────────────────────────────────────────────────────────────────────────

model Goal {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String // "workouts", "protein", "steps", "sleep", ...
  label     String
  target    Float
  unit      String
  cadence   GoalCadence
  tone      String      @default("pink")
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())

  entries GoalEntry[]

  @@unique([userId, key])
}

model GoalEntry {
  id        String   @id @default(cuid())
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  periodKey String // "2026-08-29" (daily) or "2026-W35" (weekly)
  value     Float    @default(0)
  completed Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([goalId, periodKey])
}

model Achievement {
  id          String @id @default(cuid())
  key         String @unique
  title       String
  detail      String
  icon        String
  targetValue Float?

  users UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  progress      Float       @default(0)
  unlockedAt    DateTime?

  @@unique([userId, achievementId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Coin wallet + trainer customization store
// ─────────────────────────────────────────────────────────────────────────────

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt

  transactions WalletTransaction[]
}

model WalletTransaction {
  id        String        @id @default(cuid())
  walletId  String
  wallet    Wallet        @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type      WalletTxnType
  amount    Int
  label     String
  createdAt DateTime      @default(now())

  @@index([walletId, createdAt])
}

model StoreItem {
  id        String        @id // stable slug e.g. "v-nova"
  category  StoreCategory
  name      String
  detail    String
  price     Int
  style     Json? // personality preset sliders
  swatch    String?
  isDefault Boolean       @default(false)

  owners UserStoreItem[]
}

model UserStoreItem {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeItemId String
  storeItem   StoreItem @relation(fields: [storeItemId], references: [id], onDelete: Cascade)
  equipped    Boolean   @default(false)
  acquiredAt  DateTime  @default(now())

  @@unique([userId, storeItemId])
}

// Full cosmetic-customization state (themes, accents, ambient effects, Kai
// looks, chat skins, profile frames / titles / badges). The catalogue itself
// is static config shared with the frontend (src/data/customization.ts); this
// row is just what a given user owns and what they have equipped per slot.
model UserCustomization {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  owned     Json     @default("[]") // string[] of catalogue item ids
  equipped  Json     @default("{}") // Record<slot, itemId>
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// System — notifications, subscription, device sync
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // "trainer_message" | "reminder" | "milestone" | "pr"
  title     String
  body      String
  readAt    DateTime?
  deepLink  String?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model Subscription {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan             String    @default("free") // "free" | "pro_monthly" | "pro_annual"
  status           String    @default("inactive") // "active" | "inactive" | "grace" | "cancelled"
  store            String? // "app_store" | "play_store"
  originalTxnId    String?
  currentPeriodEnd DateTime?
  updatedAt        DateTime  @updatedAt
}

model DeviceConnection {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    String // "apple_health" | "health_connect" | "apple_watch" | "wear_os" | "whoop" | "oura" | "garmin"
  status      String    @default("connected") // "connected" | "disconnected" | "error" | "pending"
  lastSyncAt  DateTime?
  lastError   String? // last sync failure message (§3.2), surfaced in Settings
  lastErrorAt DateTime?
  createdAt   DateTime  @default(now())

  // OAuth (§3.3) — WHOOP / Oura / Garmin. Tokens are provider secrets; never
  // returned to the client.
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  scope          String?
  externalUserId String? // the account id on the provider's side

  @@unique([userId, provider])
}

/// Daily nutrition log (§5). One row per logged item; the daily totals are a
/// sum. Kept deliberately simple — no barcode DB, no recipe engine.
model NutritionEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String // "YYYY-MM-DD" in the user's local day
  label     String? // "breakfast", "chicken & rice", ...
  calories  Int?
  proteinG  Float?
  carbsG    Float?
  fatG      Float?
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, date])
}

// ─────────────────────────────────────────────────────────────────────────────
// Food logging & nutrition tracking
//
// `Food` rows are a NORMALIZED CACHE of external source records (Open Food Facts,
// USDA FoodData Central) plus user-authored custom foods. They are kept
// logically distinct from `FoodLog` (the user's own diary). Provenance
// (`source`, `sourceId`, `barcode`) is preserved on every cached row. The `Food`
// table is a lookup cache refreshed from source — not a redistributable dataset.
// See services/food/* and modules/food.ts.
// ─────────────────────────────────────────────────────────────────────────────

enum FoodSource {
  open_food_facts
  usda
  custom
}

enum MealType {
  breakfast
  lunch
  dinner
  snack
}

/// Normalized, cached food record. Nutrition is stored per-100g/ml unless the
/// source only published per-serving numbers (`perServingOnly`).
model Food {
  id       String     @id @default(cuid())
  source   FoodSource
  sourceId String // OFF barcode, USDA fdcId, or a cuid for custom foods
  barcode  String?
  name     String
  brand    String?
  imageUrl String?

  // the canonical serving the source describes ("1 serving" / "1 container")
  servingSize  Float?
  servingUnit  String?
  servingGrams Float? // grams that serving weighs, when the source says so

  // nutrition, normalized. `dataPer` records the basis.
  caloriesPer100 Float
  proteinPer100  Float
  carbsPer100    Float
  fatPer100      Float
  fiberPer100    Float?
  sugarPer100    Float?
  sodiumPer100   Float? // milligrams

  micros         Json? // { "<key>": { amount, unit } } — room for micronutrients later
  perServingOnly Boolean @default(false)
  dataPer        String  @default("100g") // "100g" | "100ml" | "serving"

  // provenance / attribution
  ownerId String? // set only when source = custom
  owner   User?   @relation("CustomFoods", fields: [ownerId], references: [id], onDelete: Cascade)
  raw     Json? // trimmed source payload, for re-normalization / debugging

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  fetchedAt DateTime @default(now()) // cache freshness

  logs      FoodLog[]
  favorites FavoriteFood[]

  @@unique([source, sourceId])
  @@index([barcode])
  @@index([ownerId])
}

/// One logged item in a user's food diary. Nutrition is SNAPSHOTTED at log time
/// so history never shifts if the source food record changes later.
model FoodLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  foodId   String?
  food     Food?       @relation(fields: [foodId], references: [id], onDelete: SetNull)
  source   FoodSource? // null for quick-add calorie entries
  sourceId String?

  foodName String // snapshot
  brand    String?

  mealType MealType

  quantity    Float  @default(1)
  servingUnit String @default("serving") // "serving" | "g" | "oz"
  grams       Float? // resolved grams, when known

  // snapshot of the computed nutrition for this entry
  calories Float
  protein  Float
  carbs    Float
  fat      Float
  fiber    Float?
  sugar    Float?
  sodium   Float?

  loggedAt  DateTime
  date      String // "YYYY-MM-DD" local day — cheap day queries
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
  @@index([userId, loggedAt])
  @@index([userId, foodId])
}

model FavoriteFood {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  foodId   String?
  food     Food?      @relation(fields: [foodId], references: [id], onDelete: Cascade)
  source   FoodSource
  sourceId String
  foodName String
  brand    String?

  createdAt DateTime @default(now())

  @@unique([userId, source, sourceId])
  @@index([userId])
}

/// Per-user daily nutrition targets. User-entered; nothing is medically
/// prescribed. One row per user.
model NutritionGoal {
  userId        String   @id
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyCalories Int?
  proteinGrams  Float?
  carbGrams     Float?
  fatGrams      Float?
  fiberGrams    Float?
  updatedAt     DateTime @updatedAt
}

/// Short-lived cache of external text searches so debounced / repeated queries
/// don't re-hit USDA. Not user data — safe to purge any time.
model FoodSearchCache {
  id        String   @id @default(cuid())
  query     String   @unique
  results   Json
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// Appearance engine · progressive disclosure · unlock progression
// ─────────────────────────────────────────────────────────────────────────────

/// Curated background/glass presets — backend-owned, changeable via seed without
/// an app release. `isDefault` seeds new users; changing it re-themes everyone
/// still on a preset (`UserAppearance.presetId != null`).
model BackgroundPreset {
  id              String  @id // slug, e.g. "aurora-plum"
  name            String
  mode            String // "solid" | "gradient" | "image"
  backgroundColor String?
  gradient        Json? // { angle, stops: [{ color, at }] }
  imageUrl        String?
  backgroundDim   Float   @default(0)
  glass           Json // { opacity, blurPx, tint }
  accentColor     String?
  sortOrder       Int     @default(0)
  isDefault       Boolean @default(false)
  minTier         String? // null = always available; else gate by progression tier
  storeItemId     String? // if set, requires owning this StoreItem (category "theme")
}

/// Per-user appearance override layer. `presetId` set → response mirrors the
/// live preset values; editing any theme field nulls it.
model UserAppearance {
  userId             String   @id
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  presetId           String?
  backgroundMode     String   @default("solid")
  backgroundColor    String   @default("#170D17")
  backgroundGradient Json?
  backgroundImageUrl String?
  backgroundDim      Float    @default(0)
  glassOpacity       Float    @default(0.72) // clamp 0.35..0.95
  glassBlurPx        Int      @default(18) // clamp 0..40
  glassTint          String   @default("#2A1623")
  accentColor        String?
  reduceMotion       Boolean  @default(false)
  updatedAt          DateTime @updatedAt
}

/// Progressive-disclosure preferences. Pure storage — the client computes
/// effective visibility as `widgetOverrides[key] ?? mode`.
model UserDisclosure {
  userId          String   @id
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode            String   @default("always") // "always" | "on_interaction"
  widgetOverrides Json     @default("{}")
  updatedAt       DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Recommendation provenance (§4) · recovery check-ins (§3.1)
// ─────────────────────────────────────────────────────────────────────────────

/// One row per deterministic recommendation. Records the inputs the rule saw,
/// which branch fired, and the numeric output — so the UI (and QA) can answer
/// "why this weight?" with the actual rule, never AI prose.
model RecommendationAudit {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      RecommendationKind
  subjectId String // exerciseId / sessionId / programId depending on kind
  inputs    Json // the counters / history the rule saw
  rule      String // which branch fired, e.g. "top_of_range_rpe<=8 → +2.5%"
  output    Json // prescribed weight / reps / sets
  createdAt DateTime           @default(now())

  performance ExercisePerformance?

  @@index([userId, kind, createdAt])
}

/// Manual recovery check-in (§3.1). A first-class readiness input when no
/// wearable data is present. Never used to synthesize an HRV / resting-HR value.
model RecoveryCheckin {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sleepH       Float?
  sleepQuality Int? // 1..5
  fatigue      Int? // 1..5 (higher = more fatigued)
  soreness     Int? // 1..5 (higher = more sore)
  note         String?
  recordedAt   DateTime @default(now())

  @@index([userId, recordedAt])
}

/// Unlock progression. `unlockedFeatures` is additive and monotonic — never revoked.
model UserProgression {
  userId           String   @id
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier             String   @default("starter") // starter | building | established | full
  unlockedFeatures String[] @default([])
  gatingEnabled    Boolean  @default(true) // false = user chose "show me everything"
  firstRunAt       DateTime @default(now())
  lastEvaluatedAt  DateTime @default(now())
}

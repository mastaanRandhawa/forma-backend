# ── Forma backend environment ────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Postgres.
#  - local docker:  docker-compose.yml provisions this exact URL
#  - Render / Neon / Supabase / RDS: paste the *External* connection string and
#    append ?sslmode=require  (hosted Postgres requires SSL)
DATABASE_URL="postgresql://forma:forma@localhost:5432/forma?schema=public"
# DATABASE_URL="postgresql://USER:PASSWORD@dpg-xxxxxxxx-a.oregon-postgres.render.com/DBNAME?sslmode=require"

# Auth
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

# CORS — allowed browser origins for production, comma-separated. In development
# ANY http(s)://localhost:<port> / 127.0.0.1 / [::1] origin is accepted
# automatically (see src/app.ts), so you don't need to list dev ports here.
WEB_ORIGIN="http://localhost:5178"

# Public URL of the web app — used to build the links inside verification /
# password-reset / email-change emails. Defaults to the first WEB_ORIGIN.
APP_WEB_URL="http://localhost:5178"

# Outbound email. Unset ⇒ the "console" transport prints the message (with the
# link/code) to the server log — usable end-to-end in dev with no mail server.
# SMTP_URL="smtp://user:pass@smtp.example.com:587"
MAIL_FROM="Forma <no-reply@forma.app>"

# Social login (Sign in with Google / Apple). Unset ⇒ the web app hides the
# buttons. Client SECRETS/keys for token verification are configured separately
# in services/social-auth.ts.
OAUTH_GOOGLE_CLIENT_ID=""
OAUTH_APPLE_CLIENT_ID=""

# AI orchestration (trainer chat / summaries / plan phrasing). Optional in dev —
# when unset the AI endpoints return deterministic canned responses.
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5"

# Appearance engine — hosts allowed for user-supplied background images
APPEARANCE_IMAGE_HOSTS="storage.local,cdn.forma.app"

# Wearable OAuth (§3.3) — optional. Unset ⇒ /me/devices/:provider/connect returns
# { configured: false }. API_PUBLIC_URL must match the redirect URI registered
# with each provider: <API_PUBLIC_URL>/api/v1/me/devices/<provider>/callback
API_PUBLIC_URL="http://localhost:4000"
WHOOP_CLIENT_ID=""
WHOOP_CLIENT_SECRET=""
OURA_CLIENT_ID=""
OURA_CLIENT_SECRET=""
GARMIN_CLIENT_ID=""
GARMIN_CLIENT_SECRET=""

# Food logging. Barcode + search run a fallback chain, stopping at the first hit
# and backfilling the local Food cache:
#   your Food DB → USDA FoodData Central → Open Food Facts → Nutritionix → Edamam
#   → (barcode only) label photo → OCR / nutrition parser
# All keys stay server-side; every call is proxied through /api/v1/food/*.

# USDA FoodData Central (free: https://fdc.nal.usda.gov/api-key-signup)
USDA_FDC_API_KEY=""
# Open Food Facts asks for an identifying User-Agent (no key).
OPEN_FOOD_FACTS_USER_AGENT="Forma/1.0 (https://forma.app; nutrition@forma.app)"
# Nutritionix (free dev tier: https://developer.nutritionix.com) — best branded /
# restaurant / UPC coverage. BOTH must be set or the tier is skipped.
NUTRITIONIX_APP_ID=""
NUTRITIONIX_APP_KEY=""
# Edamam Food Database API (https://developer.edamam.com) — wired but DARK until
# BOTH are set.
EDAMAM_APP_ID=""
EDAMAM_APP_KEY=""
# Max decoded size (bytes) accepted for a label photo sent to the OCR fallback.
FOOD_LABEL_MAX_BYTES="2500000"
# Days a cached Food row is fresh before it is re-fetched from source.
FOOD_CACHE_TTL_DAYS="30"
